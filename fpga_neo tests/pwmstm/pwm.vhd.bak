			rst : in std_logic;
			pwm : out std_logic
	);
end btnstm;

architecture bhv of btnstm is

type state_type is (idle,compte,arret);

signal led_signal : std_logic_vector (3 downto 0);
signal  cpt : std_logic;
signal ep : state_type;
signal es : state_type;


